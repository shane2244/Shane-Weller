# Environment variables example for ShaneAI (features/ai/github-app)

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-secure-random-string

# AI provider (OpenAI)
OPENAI_API_KEY=sk-...

# Optional (GitHub OAuth)
GITHUB_ID=
GITHUB_SECRET=

# Public app name
NEXT_PUBLIC_APP_NAME=ShaneAI
